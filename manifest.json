{
  "manifest_version": 3,
  "name": "Locator Lens",
  "version": "0.1.0",
  "description": "Click any element to get the most robust Playwright or Cypress locator for it.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": {
    "default_title": "Locator Lens (Alt+Shift+L)",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "commands": {
    "toggle-lens": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Turn Locator Lens on or off"
    }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
